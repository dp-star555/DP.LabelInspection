<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <Version>0.2.0-preview.1</Version>
    <Product>DP.LabelInspection</Product>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- 下方明确固定net48参考程序集版本，避免本机已安装的目标框架包改变锁定依赖图。 -->
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <!-- 原图整数范围统一使用DP.Vision的PixelBounds；PixelRect保留为全局别名，源码写法与持久化JSON格式均不变。 -->
    <Using Include="DP.Vision.Algorithms.PixelBounds" Alias="PixelRect" />
    <!-- 码印刷检查参数与DP.Vision逐字段一致，直接使用Vision类型（配方JSON属性名不变）。码观测与模块网格不统一：标签侧网格角点为像素中心坐标，Vision为像素边缘坐标。 -->
    <Using Include="DP.Vision.Algorithms.BarcodePrintOptions" Alias="BarcodePrintOptions" />
    <!-- OCR单行识别结果及其CTC观测与DP.Vision逐字段一致，直接使用Vision类型。 -->
    <Using Include="DP.Vision.Algorithms.TextLineRecognition" Alias="TextLineRecognition" />
    <Using Include="DP.Vision.Algorithms.CtcStep" Alias="CtcStep" />
    <Using Include="DP.Vision.Algorithms.CtcToken" Alias="CtcToken" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
