<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net48</TargetFramework>
        <UseWindowsForms>true</UseWindowsForms>
        <HalconRoot Condition="'$(HalconRoot)'==''">$(HALCONROOT)</HalconRoot>
    </PropertyGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/DP.LabelInspection/DP.LabelInspection.csproj" />
        <ProjectReference Include="../../src/DP.LabelInspection.Adapter.Vision/DP.LabelInspection.Adapter.Vision.csproj" />
        <ProjectReference Include="../../../DP.Vision/src/DP.Vision.Winform/DP.Vision.Winform.csproj" />
        <Reference Include="halcondotnet">
            <HintPath>$(HalconRoot)/bin/dotnet35/halcondotnet.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
